# Copy this file to .env and replace the placeholder paths.

SCANFLOW_PROJECT_DIR=/path/to/ScanFlow
SCANFLOW_MODEL_PATH=/path/to/scanflow/model
SCANFLOW_DATASETS_ROOT=/path/to/datasets
SCANFLOW_OUTPUT_DIR=/path/to/evaluation/output
SCANFLOW_DEEPSEEK_VLLM_DIR=/path/to/ScanFlow/DeepSeek-OCR-2/DeepSeek-OCR2-master/DeepSeek-OCR2-vllm
HF_HOME=/path/to/huggingface/cache
